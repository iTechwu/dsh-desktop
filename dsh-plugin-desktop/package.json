    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tsdown": "0.22.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.8"
  },
  "build": {
    "appId": "ai.yootun.agent",
    "productName": "Yootun-Agent",
    "asar": true,
    "asarUnpack": [
      "package.json",
      "cordis.patch.yml",
      "build/**",
      "lib/**",
      "node_modules/**"
    ],
    "afterPack": "./scripts/verify-packaged-runtime.ts",
    "electronFuses": {
      "runAsNode": true
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "toolsets": {
      "nsis": "1.2.1"
    },
    "files": [
      "build/app-icon.png",
      "build/app-icon-mac.png",
      "build/brand-logo.png",
      "build/tray-icon*.png",
      "cordis.patch.yml",
      "lib/**",
      "package.json",
      "!node_modules/koffi-darwin-*-3-1-1/**",
      "!node_modules/node-pty/build/**"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh_CN"
        ]
      },
      "hardenedRuntime": true,
      "icon": "build/app-icon-mac.png",
      "mergeASARs": false,
      "notarize": true,
      "signIgnore": [
        "\\.(?:pak|dat|wasm)$"
      ],
      "x64ArchFiles": "**/node_modules/{node-pty/prebuilds/darwin-*/**,node-addon-require-builtin-darwin-*/**,@vscode/ripgrep-darwin-*/**,@img/sharp-darwin-*/**,@img/sharp-libvips-darwin-*/**,@koromix/koffi-darwin-*/**}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Yootun-Agent-${version}-${arch}-Portable.${ext}",
      "icon": "build/app-icon.png"
    },
    "nsis": {
      "include": "installer.nsh",
      "license": "THIRD_PARTY_NOTICES.md",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false,
      "shortcutName": "Yootun-Agent",
      "useZip": false,
      "artifactName": "Yootun-Agent-${version}-${arch}-Setup.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/app-icon.png"
    }
  }
}
