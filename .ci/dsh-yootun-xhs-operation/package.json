{
  "name": "@dofe/dsh-yootun-xhs-operation",
  "version": "0.1.0",
  "description": "Yootun 小红书运营工作台：文案方向/视频理解开关生成单版可编辑文案（复制/重新生成），账号管理与草稿箱发布分阶段交付",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "lib",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "playwright-core": "^1.62.0"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT",
  "private": true
}
