{
  "name": "@dofe/dsh-yootun-dashboard",
  "version": "0.1.0",
  "description": "Yootun enterprise dashboard for GEO, model spend, and local Agent activity",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "lib"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "check": "npm run build && node --check src/client.js && node --check lib/client.js && npm test"
  },
  "license": "MIT",
  "private": true
}
